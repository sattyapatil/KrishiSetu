{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@krishisetu/core": ["packages/core/src/index.ts"],
      "@krishisetu/config": ["packages/config/src/index.ts"],
      "@krishisetu/contracts": ["packages/contracts/src/index.ts"],
      "@krishisetu/i18n": ["packages/i18n/src/index.ts"],
      "@krishisetu/policy": ["packages/policy/src/index.ts"],
      "@krishisetu/design-tokens": ["packages/design-tokens/src/index.ts"],
      "@krishisetu/design-tokens/css": ["packages/design-tokens/generated/krishisetu.tokens.css"],
      "@krishisetu/design-system": ["packages/design-system/src/index.ts"],
      "@krishisetu/observability": ["packages/observability/src/index.ts"],
      "@krishisetu/database": ["packages/database/src/index.ts"],
      "@krishisetu/testing": ["packages/testing/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*",
    "modules/*/src/**/*",
    "apps/*/src/**/*",
    "apps/*/app/**/*",
    "tools/*/src/**/*",
    "tests/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".next"
  ]
}
