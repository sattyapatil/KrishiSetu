{
  "name": "krishisetu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "KrishiSetu - Agricultural Digital Public Infrastructure (DPI) Prototype",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "modules/*",
    "tools/*"
  ],
  "scripts": {
    "dev": "node tools/development/start-dev.mjs",
    "dev:web": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:boundaries",
    "lint:boundaries": "bash .agents/skills/develop-krishisetu/scripts/validate-foundation.sh",
    "codegen": "tsx tools/codegen/src/index.ts",
    "codegen:check": "tsx tools/codegen/src/check-drift.ts",
    "db:migrate": "tsx tools/database/src/index.ts ensure",
    "db:seed": "tsx tools/database/src/index.ts ensure",
    "db:reset": "tsx tools/database/src/index.ts reset",
    "test": "tsx --test packages/**/*.test.ts modules/**/*.test.ts tools/**/*.test.ts apps/**/*.test.ts",
    "test:unit": "tsx --test packages/**/*.test.ts modules/**/*.test.ts",
    "test:architecture": "tsx --test tools/architecture-tests/src/boundary.test.ts",
    "test:locales": "tsx --test tools/architecture-tests/src/locale-completeness.test.ts",
    "test:a11y": "tsx --test packages/design-system/src/*.test.ts",
    "test:contract": "tsx --test apps/api/src/*.test.ts",
    "test:integration": "tsx --test packages/database/src/*.test.ts apps/api/src/*.test.ts",
    "smoke:public": "tsx tools/smoke/src/public-smoke.ts",
    "validate:foundation": "bash .agents/skills/develop-krishisetu/scripts/validate-foundation.sh",
    "validate:fixtures": "tsx tools/architecture-tests/src/validate-fixtures.ts",
    "validate:security": "bash .agents/skills/develop-krishisetu/scripts/validate-foundation.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
