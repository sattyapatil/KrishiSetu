# KrishiSetu Environment Configuration Example
# Validated strictly through packages/config/src/env.schema.ts

NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DEFAULT_LOCALE=en
PROTOTYPE_MODE=true

# Web App Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_PROTOTYPE_MODE=true

# Mock Security & Session Keys (Development / Synthetic demo keys only)
SESSION_SECRET=dev-prototype-session-secret-min-32-chars-long
CSRF_SECRET=dev-prototype-csrf-secret-min-32-chars-long

# Database (SQLite prototype adapter)
DATABASE_PATH=./krishisetu.sqlite
