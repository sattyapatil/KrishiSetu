{
  "name": "@krishisetu/i18n",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative locale registry, message catalogs, formatters, and resolution for KrishiSetu",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/*": "./messages/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts"
  },
  "type": "module"
}
