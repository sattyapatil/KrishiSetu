{
  "name": "@krishisetu/design-tokens",
  "version": "0.1.0",
  "private": true,
  "description": "Authoritative JSON design tokens and generated CSS/Tailwind mappings for KrishiSetu",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css": "./generated/krishisetu.tokens.css",
    "./tokens/*": "./tokens/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts"
  },
  "type": "module"
}
